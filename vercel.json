{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/yoklama", "destination": "/attendance.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/t/:token", "destination": "/index.html" },
    { "source": "/api/profile", "destination": "/api/profile.js" },
    { "source": "/api/alert", "destination": "/api/alert.js" },
    { "source": "/api/attendance", "destination": "/api/attendance.js" },
    { "source": "/", "destination": "/index.html" }
  ]
}
